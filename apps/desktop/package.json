{
  "license": "Apache-2.0",
  "name": "@silverhand/desktop",
  "productName": "Silverhand",
  "version": "0.5.0",
  "private": true,
  "description": "Silverhand \u2014 multi-agent coding hub (Electron desktop client)",
  "author": "shiki",
  "main": "./out/main/index.js",
  "scripts": {
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "dev": "electron-vite dev",
    "dev:headless": "SILVERHAND_HEADLESS=1 electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "start": "electron-vite preview",
    "start:headless": "electron-vite build && SILVERHAND_HEADLESS=1 electron ./out/main/index.js",
    "package": "../../scripts/package.sh",
    "package:dir": "../../scripts/package.sh --dir"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@silverhand/host": "workspace:*",
    "@silverhand/shared": "workspace:*",
    "@tailwindcss/language-server": "0.16.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22.19.17",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.8.1",
    "electron-updater": "^6.8.9",
    "electron-vite": "6.0.0-beta.1",
    "typescript": "^5.6.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "@silverhand/client": "workspace:*",
    "@silverhand/app-ui": "workspace:*"
  }
}
